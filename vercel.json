{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/store", "destination": "/storefront.html" },
    { "source": "/store/:slug", "destination": "/storefront.html?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
